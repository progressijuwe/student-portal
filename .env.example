###############################################################################
# API
#
# Where the Laravel backend is served from, including the /api prefix. This is
# the only variable the running application actually requires; without it the
# axios client falls back to http://localhost:8000/api.
#
# Vite inlines these at build time, so a change needs a dev-server restart and
# a rebuild for production — and anything put here ships to the browser. Never
# place a secret in this file.
###############################################################################
VITE_API_BASE_URL=http://localhost:8000/api

###############################################################################
# Google Maps — optional, currently unused
#
# `ClassLocation.jsx` reads this to draw a walking route to the next class, but
# nothing imports that component — the timetable renders `ClassPlaceholder`
# instead. Documented so the variable is not a mystery if that view is ever
# wired up. Leaving it commented out is correct today and changes nothing.
###############################################################################
# VITE_GOOGLE_MAPS_API_KEY=
